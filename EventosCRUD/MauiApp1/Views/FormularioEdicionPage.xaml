<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.FormularioEdicionPage"
             Title="Editar Evento">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Editar evento"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Entry x:Name="tituloEntry"
                   Placeholder="Título del evento" />

            <Editor x:Name="descripcionEditor"
                    Placeholder="Descripción"
                    AutoSize="TextChanges" />

            <Label Text="Fecha y hora de inicio" FontAttributes="Bold" />
            <DatePicker x:Name="fechaInicioPicker" />
            <TimePicker x:Name="horaInicioPicker" />

            <Label Text="Fecha y hora de fin" FontAttributes="Bold" />
            <DatePicker x:Name="fechaFinPicker" />
            <TimePicker x:Name="horaFinPicker" />

            <Entry x:Name="etiquetasEntry"
                   Placeholder="Etiquetas separadas por coma" />

            <Button Text="Guardar Cambios"
                    Clicked="OnGuardarCambiosClicked"
                    BackgroundColor="#2196F3"
                    TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>